# AgriVox Smart Agriculture Platform - Environment Variables
# ==========================================================

# -------------------------------------------------
# Database Configuration
# -------------------------------------------------
# For local development, SQLite is used automatically
# For production, configure PostgreSQL:
POSTGRES_USER=agrivox
POSTGRES_PASSWORD=agrivox_password
POSTGRES_DB=agrivox_db

# Database URL for Prisma
# SQLite (local): file:./dev.db
# PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=file:./dev.db

# -------------------------------------------------
# AI Configuration (Required for full functionality)
# -------------------------------------------------

# Google Gemini API Key (Primary AI provider) [REQUIRED]
# Get your key at: https://aistudio.google.com/apikey
# Used for: Voice processing, crop health analysis, conversation flow
GEMINI_API_KEY=

# -------------------------------------------------
# Weather API (NEW - Smart Agriculture Feature)
# -------------------------------------------------
# OpenWeatherMap API Key for agricultural weather intelligence
# Get your free key at: https://openweathermap.org/api
# Enables: Real-time weather, 5-day forecast, irrigation recommendations
# If not provided, simulated weather data is used
OPENWEATHERMAP_API_KEY=

# -------------------------------------------------
# Mandi Price API (Optional)
# -------------------------------------------------
# Government of India data.gov.in API key for live mandi prices
# Get your key at: https://data.gov.in/developer
# If not provided, simulated prices are used
DATA_GOV_IN_API_KEY=

# -------------------------------------------------
# Next.js Configuration
# -------------------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Port configuration (default: 3001)
PORT=3001
