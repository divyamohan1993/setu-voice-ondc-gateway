# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ===========================================
# Dependencies
# ===========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===========================================
# Build outputs
# ===========================================
/.next/
/out/
/build
/dist
/docs/*

# ===========================================
# Database files (dev only)
# ===========================================
*.db
*.sqlite
*.sqlite3
dev.db
dev.db-journal

# ===========================================
# Environment files (NEVER commit API keys!)
# ===========================================
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
!.env.example

# ===========================================
# API Keys and Secrets (extra safety)
# ===========================================
*.key
*.secret
*_key
*_secret
temp_agent_key
temp_agent_key.pub
gcp_deploy_key.pub
gcp_deploy_key

# ===========================================
# Testing & Coverage
# ===========================================
/coverage
*.lcov
.nyc_output

# ===========================================
# TypeScript
# ===========================================
*.tsbuildinfo
tsconfig.tsbuildinfo

# ===========================================
# Logs
# ===========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===========================================
# OS generated files
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===========================================
# IDE and editor files
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ===========================================
# Prisma
# ===========================================
prisma/migrations/

# ===========================================
# Vercel
# ===========================================
.vercel

# ===========================================
# Docker (local volumes)
# ===========================================
docker-data/
.docker/

# ===========================================
# Temporary files
# ===========================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ===========================================
# Misc generated files
# ===========================================
*.pem
next-env.d.ts
.mailmap

# ===========================================
# Cache directories
# ===========================================
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache

# ===========================================
# Documentation builds (keep source)
# ===========================================
docs/_build/
docs/.docusaurus/

# ===========================================
# Test artifacts
# ===========================================
test-results/
playwright-report/
playwright/.cache/

# ===========================================
# Package manager lock files (keep one)
# ===========================================
# Keep package-lock.json, ignore others
yarn.lock
pnpm-lock.yaml
bun.lockb
